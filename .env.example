# Copy this file to .env and fill in real values. Never commit .env.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Token Jenkins sends in the X-API-Token header when it reports a deployment.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_TOKEN=change-me

# Database. Leave unset for a local SQLite file (dashboard/instance/sentinelops.db).
# MySQL example: mysql+pymysql://sentinel:password@localhost:3306/sentinelops
# DATABASE_URL=

# MySQL (used by docker-compose.yml). Letters and numbers only.
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me
